# gamayun-nas-apps: Caddy — вход в веб-приложения на поддоменах (:443, forward_auth к gamayund).
# Конфигурацию задаёт только gamayund через admin API (unix-сокет /run/gamayun-caddy/admin.sock, группа gamayun).
# Без опубликованных приложений Caddy ничего не слушает. Конфиг переживает перезапуск (--resume).
[Unit]
Description=gamayun-nas apps: Caddy (прокси приложений)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=gamayun-caddy
Group=gamayun
Environment=HOME=/var/lib/gamayun-caddy XDG_DATA_HOME=/var/lib/gamayun-caddy XDG_CONFIG_HOME=/var/lib/gamayun-caddy/config
ExecStart=/usr/lib/gamayun-nas-apps/bin/caddy run --resume --config /usr/lib/gamayun-nas-apps/caddy-bootstrap.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
StateDirectory=gamayun-caddy
StateDirectoryMode=0700
RuntimeDirectory=gamayun-caddy
RuntimeDirectoryMode=0750
UMask=0027
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
